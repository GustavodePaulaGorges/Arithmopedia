[sub_resource type="Resource" id="Resource_kbr3v"]
script = ExtResource("1_e4kvc")
char_name = "Numeron"
text = "Vejo que conseguiram chegar até mim, mas há! Pouco importa..."
texture = ExtResource("2_yfmw1")
metadata/_custom_type_script = "uid://b53h58t0u6r53"

[sub_resource type="Resource" id="Resource_v6rha"]
script = ExtResource("1_e4kvc")
char_name = "Numeron"
text = "A profecia do khaos está cumprida, e meu poder é grande demais para 2 meros matemágicos como vocês me derrotarem, ainda mais que os números disponíveis aqui são baixos demais pra se fazer qualquer coisa!!! MUAHAHAHA"
texture = ExtResource("2_yfmw1")
metadata/_custom_type_script = "uid://b53h58t0u6r53"

[sub_resource type="Resource" id="Resource_2svgw"]
script = ExtResource("1_e4kvc")
char_name = "Pitáclides"
text = "*sussurando* Parece que o Numeron não leu direito a profecia, e não sabe da parte em que nós 2 o derrotamos!"
texture = ExtResource("3_bf3up")
metadata/_custom_type_script = "uid://b53h58t0u6r53"

[sub_resource type="Resource" id="Resource_4sq6c"]
script = ExtResource("1_e4kvc")
char_name = "Pitáclides"
text = "*sussurrando* bem.. essa parte eu inventei mesmo, mas eu tenho certeza que iremos derrotar ele! por isso, vou te disponibilizar minha última e mais interessante torre..."
texture = ExtResource("3_bf3up")
metadata/_custom_type_script = "uid://b53h58t0u6r53"

[sub_resource type="Resource" id="Resource_h5xtg"]
script = ExtResource("1_e4kvc")
char_name = "Pitáclides"
text = "*sussurrando* É a torre de duplicação! Ela pega um número e o duplica, assim poderemos aplicar a sequência de Fibonacci e então transformar esses números pequenos em valores grandes o suficientes pra derrotà-lo!!"
texture = ExtResource("3_bf3up")
metadata/_custom_type_script = "uid://b53h58t0u6r53"

[sub_resource type="Resource" id="Resource_eufck"]
script = ExtResource("1_e4kvc")
char_name = "Numeron"
text = "EI EI, SOBRE O QUÊ VOCÊS ESTÃO COCHICHANDO AÌ???"
texture = ExtResource("2_yfmw1")
metadata/_custom_type_script = "uid://b53h58t0u6r53"

