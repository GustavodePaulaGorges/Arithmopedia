[sub_resource type="Resource" id="Resource_yekyu"]
script = ExtResource("1_7j6iw")
char_name = "Pitáclides"
text = "Olá aventureiro! Vou te ensinar como utilizar as torres matemáticas para me ajudar nessa aventura."
texture = ExtResource("2_htuc8")
metadata/_custom_type_script = "uid://b53h58t0u6r53"

[sub_resource type="Resource" id="Resource_brpww"]
script = ExtResource("1_7j6iw")
char_name = "Pitáclides"
text = "Para colocar uma torre, clique nela no canto inferior direito, e depois na àrea com o pontilhado branco!"
texture = ExtResource("2_htuc8")
metadata/_custom_type_script = "uid://b53h58t0u6r53"

[sub_resource type="Resource" id="Resource_kiknm"]
script = ExtResource("1_7j6iw")
char_name = "Pitáclides"
text = "E se cometer um erro, pode usar o clique direito para remover uma torre! Errar é necessário para o aprendizado!"
texture = ExtResource("2_htuc8")
metadata/_custom_type_script = "uid://b53h58t0u6r53"

[sub_resource type="Resource" id="Resource_htuc8"]
script = ExtResource("1_7j6iw")
char_name = "Pitáclides"
text = "Temos apenas uma torre disponível no momento, a de adição, ela vai pegar 2 números e somá-los, utilize esse poder com cautela!"
texture = ExtResource("2_htuc8")
metadata/_custom_type_script = "uid://b53h58t0u6r53"

