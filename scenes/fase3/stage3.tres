[resource]
script = ExtResource("1_l8jkj")
stage_id = 3
stage_title = "Fase 3 (Sete é a Chave)"
stage_criteria = "Fazer exatamente o número 7"
stage_history = "Na vastidão do Vale das Três Montanhas, Pitáclides encontra inscrições antigas talhadas na pedra: “Quando tudo parecer perdido, lembre-se: sete é a chave.” Dizem que este trecho da Arithmopedia guarda um enigma criado pelos próprios Magos Primevos, um teste para provar se a mente do viajante realmente enxerga além da aritmética comum."
stage_hint = "Nem sempre o caminho mais simples é o que revela a resposta. Nesta fase, o resultado depende do ritmo das operações: às vezes é preciso reduzir primeiro, depois reunir forças, e então reduzir mais uma vez para chegar ao valor esperado."
prize_text = "Quando várias operações acontecem em sequência, elas formam uma “árvore de operações”. Se um número não tem par em uma etapa, ele segue sozinho para a próxima, sendo combinado depois. Isso é comum tanto em matemática quanto em estruturas de computação. Em resumo, números solitários também são importantes e podem ser essenciais para alcançar o resultado final."
enemy_array = Array[int]([14, 7, 9, 4, 5, 2, 6, 4])
victory_type = 2
victory_target = 7
tower_count = {
0: 2,
1: 2
}
