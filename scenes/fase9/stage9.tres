[resource]
script = ExtResource("1_jhtww")
stage_id = 9
stage_title = "Fase 9 (Quadrados Perfeitos)"
stage_criteria = "Fazer 4 quadrados perfeitos"
stage_history = "Agora, adentrando a caverna dos anões da Ordem de Potenradi, Pitáclides chega à Arqui-Câmara, um vasto laboratório geométrico onde os anões-cientistas estudam números e formas com precisão absoluta. Há séculos, eles lapidam combinações matemáticas e analisam cada valor com extremo rigor. Para avançar, Pitáclides deve seguir essa tradição, reorganizando e combinando os números para revelar sua verdadeira natureza e formar um conjunto perfeitamente equilibrado."
stage_hint = "Observe quais números escondem uma forma mais simples. Quando um valor puder virar outro menor de forma exata, ele pode indicar o caminho da radiciação. Esses resultados simplificados talvez formem pares equilibrados ao se reencontrarem na esteira final."
prize_text = "A radiciação e a potenciação são operações inversas, como abrir e fechar uma mesma porta. Números chamados de quadrados perfeitos podem ser “desempacotados” por uma raiz para revelar sua forma essencial. Essa relação aparece em várias áreas: geometria, progressões, áreas de quadrados e até em otimização. Quando números que foram simplificados encontram valores compatíveis, eles podem gerar produtos idênticos, criando padrões simétricos que são muito usados em equações e em problemas de fatoração."
enemy_array = Array[int]([16, 9, 9, 12, 36, 6, 4, 18])
victory_type = 8
tower_count = {
2: 2,
3: 2,
4: 2,
5: 2
}
