[sub_resource type="Resource" id="Resource_umfh0"]
script = ExtResource("1_hcdrp")
char_name = "Pitáclides"
text = "Estamos chegando ao fim da nossa aventura, você se tornou um matemágico(a) de respeito! Vou te indicar pro Rei quando terminarmos de limpar essa baguça :)"
texture = ExtResource("2_qtsrc")
metadata/_custom_type_script = "uid://b53h58t0u6r53"

[sub_resource type="Resource" id="Resource_u0pug"]
script = ExtResource("1_hcdrp")
char_name = "Pitáclides"
text = "Você tem acesso agora a algumas das minhas torres mais poderosas, a potenciação e a radiciação, essas torres apenas recebem 1 número, e fazem o seu valor ao quadrado, ou sua raiz quadrada, respectivamente."
texture = ExtResource("2_qtsrc")
metadata/_custom_type_script = "uid://b53h58t0u6r53"

[sub_resource type="Resource" id="Resource_qtsrc"]
script = ExtResource("1_hcdrp")
char_name = "Pitáclides"
text = "Tenha isso em mente ao utilizá-las, seu comportamento é levemente diferente das outras torres que conhecemos até o momento."
texture = ExtResource("2_qtsrc")
metadata/_custom_type_script = "uid://b53h58t0u6r53"

